rules_version = '2';

// Centro de Mando — un solo usuario, un solo documento (appdata/lifedash_v2).
// Solo el dueño autenticado con Google (este uid) puede leer/escribir sus datos.
// Todo lo demás queda denegado por defecto.
service cloud.firestore {
  match /databases/{database}/documents {
    match /appdata/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == "vy1BtfYJTJcbuAPWlRRPA0OKsOJ3";
    }

    // Cache de voz de JARVIS: cada doc es el MP3 (base64) de una frase ya sintetizada, para
    // que la misma frase no se le pague dos veces a ElevenLabs desde dos dispositivos.
    // Coleccion aparte de appdata a proposito (ver jarvis-voice.js): appdata se lee entera
    // con .get() en varias funciones y arrastraria todos los audios.
    match /jarvis_tts/{ttsId} {
      allow read, write: if request.auth != null
        && request.auth.uid == "vy1BtfYJTJcbuAPWlRRPA0OKsOJ3";
    }
  }
}
